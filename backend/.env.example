NODE_ENV=development
PORT=3002

# Postgres (Phase 1)
# Printed by scripts/create-database.sh — paste it here.
DATABASE_URL=

# Sessions (Phase 1)
SESSION_SECRET=change-me-to-a-long-random-string

# Google Sheets (Phase 2)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# Scaleway Generative APIs (Phase 3)
# The secret key alone authenticates; SCW_ACCESS_KEY and the project /
# organisation IDs belong to other Scaleway services and are not needed here.
SCW_SECRET_KEY=
SCW_MODEL=qwen3.6-35b-a3b
# Optional — defaults to https://api.scaleway.ai/v1
SCW_BASE_URL=

# Per-call timeouts, in milliseconds. Node's fetch has none of its own, so
# without these a stalled provider hangs the student's request indefinitely.
# Measured latencies: scoring 3.4-6.0 s, summary 2.7-3.7 s. The defaults are
# several times that on purpose — a timeout that fires on a healthy call costs
# a student their answer, which is far worse than waiting.
# LLM_TIMEOUT_MS=45000
# The closing summary can give up sooner: the interview is already complete and
# stored by then, and the text regenerates on the next load of the session.
# LLM_SUMMARY_TIMEOUT_MS=20000

# Email invitations.
#
# MAIL_TRANSPORT picks the path: "resend" or "smtp". Set it explicitly on any
# host that carries both sets of credentials — otherwise adding a variable to
# test something silently switches how a live service sends mail. Left unset,
# SMTP is used when SMTP_HOST exists, Resend otherwise. Whichever is chosen is
# logged on the first send.
MAIL_TRANSPORT=smtp

# --- transport: resend
RESEND_API_KEY=

# --- transport: smtp
#
# Any server that speaks SMTP works. Prefer the school's own: an invitation
# asking a student to set a password should arrive from an address they
# recognise, and mail sent through the school's own system introduces no
# processor the school does not already have.
#
# SMTP_PORT: 587 (STARTTLS) or 465 (implicit TLS). Port 25 is blocked outbound
# by most hosting providers and will simply time out.
# SMTP_USER/PASS: omit both for an internal relay that accepts this host by
# address. For Google Workspace or Microsoft 365 with 2FA, this must be an app
# password, not the account password.
#
# Check it before trusting it:  node scripts/check-mail.mjs you@example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=  # only to override the default implied by the port
EMAIL_FROM="RISE <no-reply@your-school.example>"
APP_ORIGIN=http://localhost:3002
INVITE_EXPIRY_HOURS=72

# ---------------------------------------------------------------------------
# Optional. Every one of these has a working default; the value shown IS the
# default. They are listed because an operator cannot discover a setting that
# is only visible in the source.
# ---------------------------------------------------------------------------

# Where invitation and password links point, when that differs from APP_ORIGIN —
# behind a proxy that terminates on a different hostname, for instance.
# PUBLIC_APP_ORIGIN=

# How long a password-reset link stays valid, in minutes. Short on purpose: the
# link is a bearer token that arrives in an inbox.
# RESET_TTL_MINUTES=60

# Erasure and access requests are a queue in the platform, with a due date,
# because Article 12(3) starts a one-month clock. Add addresses here to be
# emailed as well — comma-separated. The queue remains the record either way.
# DATA_REQUEST_NOTIFY=

# ---- interview shape ----
# Questions served per interview, unless a scenario overrides it.
# SESSION_QUESTION_COUNT=10
# Ceiling on one written answer. A guard against runaway cost, not a word limit:
# 4000 characters is roughly 650 words, far beyond any spoken answer.
# MAX_ANSWER_CHARS=4000

# ---- dictation ----
# SCW_TRANSCRIBE_MODEL=whisper-large-v3
# TRANSCRIBE_TIMEOUT_MS=60000
# MAX_AUDIO_BYTES=8388608
# Recordings per user per hour. Keyed on the user, not the address, because a
# class shares one address and thirty students dictating at once is the normal
# case rather than the attack.
# DICTATION_RATE_LIMIT=40

# How long imported content is held in memory before the sheet is re-read.
# SHEET_CACHE_TTL_MS=300000

# ---------------------------------------------------------------------------
# Do not set these on a server
# ---------------------------------------------------------------------------

# Writes prompts and model replies to the log verbatim — which means student
# answers, in plain text, in a file with a different retention and a different
# set of readers from the database. For debugging a prompt on a machine with no
# real data on it. Never on a host students use.
# LLM_LOG_RAW_CONTENT=1

# `npm run seed` creates demo accounts and refuses to run when NODE_ENV is
# production. This overrides that refusal. The refusal is the feature.
# SEED_ALLOW_PRODUCTION=1
# SEED_PASSWORD / SEED_ADMIN_PASSWORD set the demo passwords instead of
# generating them. Same warning.
